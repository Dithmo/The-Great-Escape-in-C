config_version=5

[application]

config/name="The Great Escape Remake"
config/description="A modern remake of the 1986 ZX Spectrum classic by Denton Designs"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
GameClock="*res://scripts/autoloads/game_clock.gd"
MoraleManager="*res://scripts/autoloads/morale_manager.gd"
RoomManager="*res://scripts/world/room_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

